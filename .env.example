# ==============================================

# AI-Agentic Observability Platform

# Environment Configuration

# ==============================================

# ==============================================

# API KEYS (REQUIRED)

# ==============================================

# Get OpenAI API key from: https://platform.openai.com/api-keys

OPENAI_API_KEY=sk-your-openai-api-key-here

# Get Anthropic API key from: https://console.anthropic.com/

ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# ==============================================

# SECURITY

# ==============================================

# Generate with: openssl rand -hex 32

SECRET_KEY=your-secret-key-change-in-production

# ==============================================

# DATABASE CONFIGURATION

# ==============================================

# PostgreSQL (Main Database)

DATABASE_URL=postgresql+asyncpg://observai:observai@postgres:5432/observai
POSTGRES_USER=observai
POSTGRES_PASSWORD=observai
POSTGRES_DB=observai

# TimescaleDB (Metrics)

TIMESCALE_URL=postgresql+asyncpg://observai:observai@timescaledb:5432/metrics
TIMESCALE_USER=observai
TIMESCALE_PASSWORD=observai
TIMESCALE_DB=metrics

# Neo4j (Knowledge Graph)

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=observai123

# Redis (Caching)

REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# ==============================================

# CLOUD PROVIDER CREDENTIALS (Optional)

# ==============================================

# Azure

AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# AWS

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# GCP

GCP_PROJECT_ID=
GCP_CREDENTIALS_FILE=/path/to/credentials.json

# ==============================================

# APPLICATION SETTINGS

# ==============================================

LOG_LEVEL=INFO
ENABLE_DEBUG=false
ENVIRONMENT=production

# API Settings

API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Frontend URL (for CORS)

FRONTEND_URL=http://localhost:3000

# ==============================================

# AGENT CONFIGURATION

# ==============================================

AGENTS_ENABLED=true
AUTO_REMEDIATION=false
AGENT_LLM_MODEL=gpt-4

# ==============================================

# MONITORING & OBSERVABILITY

# ==============================================

OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
PROMETHEUS_URL=http://prometheus:9090

# ==============================================

# OPTIONAL: EXTERNAL SERVICES

# ==============================================

# Slack Notifications

SLACK_WEBHOOK_URL=

# Email Notifications

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@observability.dev

# PagerDuty

PAGERDUTY_API_KEY=
PAGERDUTY_SERVICE_ID=
