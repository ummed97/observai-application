# ============================================
# AI-Agentic Observability Platform
# Environment Configuration
# ============================================

# ===== AI/LLM API Keys (REQUIRED) =====
# Get your OpenAI key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-key-here

# Get your Anthropic key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ===== Security =====
# Generate with: openssl rand -hex 32
SECRET_KEY=your-secret-key-change-in-production-use-openssl-rand-hex-32

# ===== Database URLs =====
# Main PostgreSQL database
DATABASE_URL=postgresql+asyncpg://observai:observai@postgres:5432/observai

# TimescaleDB for metrics
TIMESCALE_URL=postgresql+asyncpg://observai:observai@timescaledb:5432/metrics

# Redis for caching
REDIS_URL=redis://redis:6379

# Neo4j for Knowledge Graph
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=observai123

# ===== Application Settings =====
LOG_LEVEL=INFO
ENABLE_DEBUG=false
WORKERS=4

# ===== Agent Configuration =====
DETECTOR_ENABLED=true
DIAGNOSER_ENABLED=true
FORECASTER_ENABLED=true
REMEDIATOR_ENABLED=true
COST_AGENT_ENABLED=true

# Auto-remediation (set to false for human approval)
AUTO_REMEDIATION=false

# ===== Data Ingestion =====
METRICS_RETENTION_DAYS=90
LOGS_RETENTION_DAYS=30
TRACES_RETENTION_DAYS=7

# ===== Cloud Provider Credentials (Optional) =====
# Azure
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# GCP
GCP_PROJECT_ID=
GCP_SERVICE_ACCOUNT_KEY=

# ===== Frontend Configuration =====
REACT_APP_API_URL=http://localhost:8000

# ===== OpenTelemetry Collector =====
OTEL_COLLECTOR_ENDPOINT=http://otel-collector:4317

# ===== Prometheus (Optional) =====
PROMETHEUS_URL=http://prometheus:9090

# ===== Grafana (Optional) =====
GRAFANA_URL=http://grafana:3000
GRAFANA_ADMIN_PASSWORD=admin
