# Backend Environment Variables

# Copy this to .env and update with your values

OPENAI_API_KEY=sk-your-key
ANTHROPIC_API_KEY=sk-ant-your-key
SECRET_KEY=your-secret-key

DATABASE_URL=postgresql+asyncpg://observai:observai@localhost:5432/observai
REDIS_URL=redis://localhost:6379
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=observai123

# Azure Service Principal Configuration
# Required for Cost Agent to authenticate as Service Principal
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-service-principal-app-id
AZURE_CLIENT_SECRET=your-service-principal-password
